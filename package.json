{
  "name": "@elastic/kbn-proto-ui",
  "version": "0.7.0",
  "description": "Kibana shared chrome, solution navigation and AI UI for prototypes.",
  "type": "module",
  "license": "Elastic-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./solution-menus": {
      "types": "./dist/solution-menus/index.d.ts",
      "import": "./dist/solution-menus/index.js",
      "default": "./dist/solution-menus/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "SOURCES.md",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "update:kbn": "node scripts/update-kbn.mjs",
    "build:library": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@elastic/eui": ">=123.0.0 <124",
    "@emotion/react": "^11.14.0",
    "@emotion/css": "^11.13.5"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@elastic/eui": "123.1.0",
    "@elastic/eui-theme-borealis": "8.1.0",
    "@emotion/react": "11.14.0",
    "@emotion/css": "11.13.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0",
    "@kbn/ui-ai-components": "0.0.0-907f0861d1c7",
    "@kbn/ui-chrome-layout": "0.0.0-56a57242d882",
    "@kbn/ui-side-navigation": "0.0.0-46c17a47d19a",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "jsdom": "^24.1.3",
    "@testing-library/react": "^16.3.0",
    "vite": "^8.3.6",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/kbn-proto-ui.git"
  },
  "private": true,
  "overrides": {
    "prismjs": "^1.30.0"
  }
}
